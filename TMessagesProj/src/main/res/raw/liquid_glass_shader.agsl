// MeeroX liquid glass shader (iOS 26 style)
// Based on Telegram's liquid_glass_shader.agsl, extended with:
//   - specular edge sheen (the bright rim that defines Apple's Liquid Glass)
//   - chromatic dispersion (R/G/B refract at slightly different indices)
//   - chroma lift so colours behind the glass stay vivid

uniform shader img;

uniform float2 resolution;
uniform float2 center;
uniform float2 size;
uniform float4 radius;
uniform float thickness;
uniform float refract_index;
uniform float refract_intensity;
uniform float4 foreground_color_premultiplied;

half sdfRect(half2 p, half4 r) {
  r.xy = (p.x > 0.0) ? r.xy : r.zw;
  r.x  = (p.y > 0.0) ? r.x  : r.y;
  half2 q = abs(p) - size + r.x;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r.x;
}

half4 srcOver(half4 src, half4 dst) {
    half3 outRGB = (src.rgb + dst.rgb * (1.0 - src.a));
    float outA = src.a + (1.0 - src.a) * dst.a;
    return half4(outRGB, outA);
}

half4 main(in float2 fragCoord) {
  half2 p = fragCoord - center;
  half sd = sdfRect(p, radius);
  half2 uv = fragCoord;

  half3 sampled;
  half sheen = 0.0;

  if (sd < 0.0) {
    half sdX = sdfRect(p + half2(1.0, 0.0), radius);
    half sdY = sdfRect(p + half2(0.0, 1.0), radius);

    half n_cos = max(thickness + sd, 0.0) / thickness;
    half n_cos2 = n_cos * n_cos;
    half n_sin = sqrt(1.0 - n_cos2);
    half2 grad = half2(sdX - sd, sdY - sd);
    half3 normal = normalize(half3(grad * n_cos, n_sin));

    half h = sd < -thickness ? thickness : sqrt(sd * (-2.0 * thickness - sd));

    // chromatic dispersion: each channel bends by a slightly different amount
    half3 idx = half3(refract_index * 0.985, refract_index, refract_index * 1.015);

    half3 rv_r = refract(half3(0.0, 0.0, -1.0), normal, 1.0 / idx.r);
    half3 rv_g = refract(half3(0.0, 0.0, -1.0), normal, 1.0 / idx.g);
    half3 rv_b = refract(half3(0.0, 0.0, -1.0), normal, 1.0 / idx.b);

    half len_r = (h + 8.0 * thickness) / -rv_r.z;
    half len_g = (h + 8.0 * thickness) / -rv_g.z;
    half len_b = (h + 8.0 * thickness) / -rv_b.z;

    half2 uv_r = fragCoord + rv_r.xy * len_r * refract_intensity;
    half2 uv_g = fragCoord + rv_g.xy * len_g * refract_intensity;
    half2 uv_b = fragCoord + rv_b.xy * len_b * refract_intensity;

    uv = uv_g;
    sampled = half3(img.eval(uv_r).r, img.eval(uv_g).g, img.eval(uv_b).b);

    // specular edge sheen, lit from the top-left like Apple's Liquid Glass
    half3 lightDir = normalize(half3(-0.45, -0.75, 0.49));
    half spec = max(dot(normal, lightDir), 0.0);
    spec = pow(spec, 26.0);

    // keep the sheen inside the refraction band near the edge
    half edgeBand = 1.0 - clamp(-sd / max(thickness, 1.0), 0.0, 1.0);
    sheen = spec * edgeBand * 0.55;

    // faint rim highlight all the way around
    half rim = smoothstep(0.0, 1.0, edgeBand);
    sheen += rim * rim * 0.06;
  } else {
    sampled = img.eval(uv).rgb;
  }

  half4 base = half4(sampled, img.eval(uv).a);

  // chroma lift: stop content behind the glass from going flat
  half luma = dot(base.rgb, half3(0.2126, 0.7152, 0.0722));
  base.rgb = mix(half3(luma), base.rgb, 1.12);

  half4 outColor = srcOver(half4(foreground_color_premultiplied), base);
  outColor.rgb = clamp(outColor.rgb + sheen, 0.0, 1.0);
  return outColor;
}
